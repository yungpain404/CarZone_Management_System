<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <!-- Persistence unit của CarZone. Schema do Flyway quản lý (infra/database/fly_way_migrations). -->
    <persistence-unit name="CarZonePU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>entity.KhachHang</class>
        <class>entity.Xe</class>
        <class>entity.NhanVien</class>
        <class>entity.TaiKhoan</class>
        <class>entity.DichVu</class>
        <class>entity.LinhKien</class>
        <class>entity.KhuyenMai</class>
        <class>entity.PhieuTiepNhanSuaChua</class>
        <class>entity.ChiTietDichVu</class>
        <class>entity.ChiTietLinhKien</class>
        <class>entity.HoaDon</class>
        <class>entity.PhieuDoiTra</class>
        <class>entity.ChiTietDoiTra</class>
        <class>entity.PhieuYeuCauNhapLinhKien</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.microsoft.sqlserver.jdbc.SQLServerDriver"/>
            <!-- Địa chỉ/tài khoản KHÔNG ghi cứng ở đây: truyền khi tạo EntityManagerFactory
                 (Persistence.createEntityManagerFactory("CarZonePU", map)) với các khóa
                 jakarta.persistence.jdbc.url / .user / .password lấy từ cấu hình của máy. -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.SQLServerDialect"/>

            <!-- Schema do Flyway tạo; Hibernate tuyệt đối không tạo/sửa bảng
                 (không dùng validate vì CHAR(14) và cột tính toán sẽ báo lỗi). -->
            <property name="hibernate.hbm2ddl.auto" value="none"/>

            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
